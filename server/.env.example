PORT=4000

# Where triage results come from:
#   mock = built-in placeholder (no Python needed)
#   http = Python pipeline service (sentineldesk.pipeline.run behind an HTTP endpoint)
TRIAGE_PROVIDER=mock
PIPELINE_URL=http://localhost:8000/triage

# Where tickets are stored:
#   memory = in-process (no database needed, resets on restart)
#   mongo  = MongoDB / Atlas
TICKET_STORE=memory
MONGODB_URI=mongodb://localhost:27017/sentineldesk

# Fill the console with demo tickets on startup
SEED_DEMO=true

# Outage detection: N similar incidents within T minutes
BURST_WINDOW_MIN=15
BURST_MIN_TICKETS=3
