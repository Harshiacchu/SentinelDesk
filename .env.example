# Copy to .env and fill in. Never commit .env.

# LLM for reply drafting: gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# true = key from Google Cloud "Gemini platform" (Vertex AI express mode); false = AI Studio key
GEMINI_USE_VERTEX=true
# Leave empty for the default (gemini-3.5-flash / claude-opus-5-5)
LLM_MODEL=

# Per-request timeout in seconds (contract section 8)
LLM_TIMEOUT_S=15
# OFFLINE=1 serves cache/demo_drafts.json instead of calling the LLM (demo safety net)
OFFLINE=0
# RECORD_DRAFTS=1 saves every good live draft into that cache: run the demo tickets once with it on
RECORD_DRAFTS=0

# Only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional overrides
SENTINEL_EMBED_MODEL=intfloat/multilingual-e5-base
SENTINEL_USE_MOCKS=0
